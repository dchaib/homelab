services:
  {{ monitoring.omada_exporter }}:
    image: rcooler/omada_exporter:2.4.5
    restart: unless-stopped
    user: "{{ docker_compose_stack_uid }}:{{ docker_compose_stack_gid }}"
    extra_hosts:
      - "{{ docker_host_gateway.hostname }}:host-gateway"
    environment:
      - OMADA_HOST={{ omada_exporter_controller_host }}
      - OMADA_USER=${OMADA_USER}
      - OMADA_PASS=${OMADA_PASS}
      - OMADA_CLIENT_ID=${OMADA_CLIENT_ID}
      - OMADA_SECRET_ID=${OMADA_SECRET_ID}
      - OMADA_SITE=Home
      - OMADA_INSECURE=true
      - OMADA_MQTT_ENABLED=false
    networks:
      - {{ docker_networks.monitoring }}

networks:
  {{ docker_networks.monitoring }}:
    external: true
