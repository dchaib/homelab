#!/bin/sh
# {{ ansible_managed }}
# Work around Intel NIC TX hangs; leave all other interfaces/features unchanged.
set -eu

case "${IFACE:-}" in
{% for interface in network_offload_workaround_interfaces %}
    '{{ interface }}')
        /usr/sbin/ethtool -K "$IFACE" tso off gso off
        ;;
{% endfor %}
esac
