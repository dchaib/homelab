http:
  routers:
    omada:
      rule: "Host(`{{ homelab_services.omada_controller.domain }}`)"
      entryPoints:
        - websecure
      service: omada
      tls:
        certResolver: ovh

  services:
    omada:
      loadBalancer:
        servers:
          - url: "https://{{ docker_host_gateway.hostname }}:{{ omada_controller.management_https_port }}"
        serversTransport: "insecure-transport"

  serversTransports:
    insecure-transport:
      insecureSkipVerify: true
