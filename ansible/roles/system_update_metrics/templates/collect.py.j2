#!/usr/bin/python3
"""Collect pending APT updates and kernel reboot status."""

import argparse
import fcntl
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import time

DEFAULT_OUTPUT = Path({{ (monitoring_textfile_directory ~ '/system_updates.prom') | to_json }})
{% raw %}
LOCK_PATH = Path("/run/lock/system-update-metrics.lock")
HELP = {
    "homelab_apt_updates_pending": "Installed packages with a newer APT candidate.",
    "homelab_apt_security_updates_pending": "Installed packages with a newer Debian security version.",
    "homelab_apt_kernel_updates_pending": "Installed kernel packages with a newer APT candidate.",
    "homelab_apt_proxmox_updates_pending": "Installed packages with a newer Proxmox candidate on PVE hosts.",
    "homelab_reboot_required": "Whether the reboot marker is present or needrestart reports an outdated kernel.",
    "homelab_system_update_collect_success": "Whether the last collection attempt succeeded, by check.",
    "homelab_system_update_last_success_timestamp_seconds": "Unix time of the last successful collection, or zero, by check.",
}
COUNT_METRICS = {
    "homelab_apt_updates_pending",
    "homelab_apt_security_updates_pending",
    "homelab_apt_kernel_updates_pending",
    "homelab_apt_proxmox_updates_pending",
}
BOOLEAN_METRICS = {
    "homelab_reboot_required",
    'homelab_system_update_collect_success{check="apt"}',
    'homelab_system_update_collect_success{check="reboot"}',
}
TIMESTAMP_METRICS = {
    'homelab_system_update_last_success_timestamp_seconds{check="apt"}',
    'homelab_system_update_last_success_timestamp_seconds{check="reboot"}',
}
ALLOWED_METRICS = COUNT_METRICS | BOOLEAN_METRICS | TIMESTAMP_METRICS


def command(*args, limit="10m"):
    # GNU timeout bounds the command and its children; no process manager in Python.
    return subprocess.check_output(
        ["/usr/bin/timeout", "--kill-after=10s", limit, *args],
        text=True, env={**os.environ, "LC_ALL": "C", "DEBIAN_FRONTEND": "noninteractive"},
    )


def count_updates(cache, compare):
    counts = dict.fromkeys(("updates", "security_updates", "kernel_updates"), 0)
    if "pve-manager" in cache and cache["pve-manager"].is_installed:
        counts["proxmox_updates"] = 0
    for package in cache:
        if not package.is_installed or not package.candidate:
            continue
        installed, candidate = package.installed.version, package.candidate
        if compare(candidate.version, installed) <= 0:
            continue
        counts["updates"] += 1
        counts["kernel_updates"] += int(package.name.startswith(("linux-image-", "proxmox-kernel-", "pve-kernel-")))
        if "proxmox_updates" in counts:
            counts["proxmox_updates"] += int(any(o.origin == "Proxmox" for o in candidate.origins))
        # A regular candidate can supersede a security version still in the indexes.
        counts["security_updates"] += int(any(
            compare(v.version, installed) > 0 and compare(v.version, candidate.version) <= 0
            and any(o.origin == "Debian" and (o.label == "Debian-Security" or o.archive.endswith("-security")) for o in v.origins)
            for v in package.versions
        ))
    return {f"homelab_apt_{name}_pending": count for name, count in counts.items()}


def collect_apt():
    command("/usr/bin/apt-get", "--error-on=any", "-o", "Acquire::Timeout=20", "-o", "Acquire::Retries=1", "update")
    import apt
    import apt_pkg

    with apt.Cache() as cache:
        return count_updates(cache, apt_pkg.version_compare)


def collect_reboot():
    if Path("/run/reboot-required").exists():
        return {"homelab_reboot_required": 1}
    output = command("/usr/sbin/needrestart", "-b", "-k", limit="1m")
    status = re.search(r"^NEEDRESTART-KSTA:\s*([1-3])\s*$", output, re.MULTILINE)
    if status is None:
        raise ValueError("needrestart kernel status is unknown")
    # 1=current, 2=ABI-compatible upgrade, 3=version upgrade; 0 is unknown.
    return {"homelab_reboot_required": int(status[1] != "1")}


def read_previous(path):
    if not path.exists():
        return {}
    values = {}
    for number, line in enumerate(path.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
        if not line.strip() or line.startswith("#"):
            continue
        try:
            key, raw_value = line.split()
            if key not in ALLOWED_METRICS:
                raise ValueError("Unknown metric")
            if not re.fullmatch(r"[0-9]+", raw_value):
                raise ValueError("Expected a non-negative integer")
            value = int(raw_value)
            if key in BOOLEAN_METRICS and value not in (0, 1):
                raise ValueError("Boolean metric must be zero or one")
        except ValueError:
            print(f"Ignoring invalid previous metric at line {number}", file=sys.stderr)
            continue
        values[key] = value
    return values


def write_metrics(path, values):
    # Rename within the shared directory so Alloy never reads a partial file.
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent, suffix=".tmp", delete=False) as stream:
        temporary = Path(stream.name)
        try:
            for name in sorted({key.split("{")[0] for key in values}):
                stream.write(f"# HELP {name} {HELP[name]}\n# TYPE {name} gauge\n")
            for name, value in sorted(values.items()):
                stream.write(f"{name} {value}\n")
            stream.flush()
            os.fchmod(stream.fileno(), 0o644)
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)


def collect(path):
    values = read_previous(path)
    failed = False
    for check, reader in (("apt", collect_apt), ("reboot", collect_reboot)):
        success = f'homelab_system_update_collect_success{{check="{check}"}}'
        last_success = f'homelab_system_update_last_success_timestamp_seconds{{check="{check}"}}'
        values.setdefault(last_success, 0)
        try:
            values.update(reader())
        except Exception as error:
            print(f"{check}: {error}", file=sys.stderr)
            values[success] = 0
            failed = True
        else:
            values[success] = 1
            values[last_success] = int(time.time())
    write_metrics(path, values)
    return int(failed)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    args = parser.parse_args(argv)
    # The open descriptor holds the lock for manual and cron executions alike.
    with LOCK_PATH.open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("System update metrics collection is already running.", file=sys.stderr)
            return 1
        return collect(args.output)


if __name__ == "__main__":
    raise SystemExit(main())
