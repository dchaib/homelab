services:
  omada-controller:
    image: mbentley/omada-controller:6.3.0.45
    restart: unless-stopped
    ulimits:
      nofile:
        soft: 4096
        hard: 8192
    stop_grace_period: 60s
    network_mode: host
    environment:
      - PUID={{ docker_compose_stack_uid }}
      - PGID={{ docker_compose_stack_gid }}
      - MANAGE_HTTP_PORT=8088
      - MANAGE_HTTPS_PORT={{ omada_controller.management_https_port }}
      - PORTAL_HTTP_PORT=8088
      - PORTAL_HTTPS_PORT=8843
      - UPGRADE_HTTPS_PORT=8043
      - UPGRADE_ES_HTTPS_PORT=8044
      - PORT_APP_DISCOVERY=27001
      - PORT_DISCOVERY=29810
      - PORT_MANAGER_V1=29811
      - PORT_ADOPT_V1=29812
      - PORT_UPGRADE_V1=29813
      - PORT_MANAGER_V2=29814
      - PORT_TRANSFER_V2=29815
      - PORT_RTTY=29816
      - PORT_DEVICE_MONITOR=29817
      - WEB_CONFIG_OVERRIDE=false
      - SHOW_SERVER_LOGS=false
      - SHOW_MONGODB_LOGS=false
      - SSL_CERT_NAME=tls.crt
      - SSL_KEY_NAME=tls.key
      - TZ=Etc/UTC
    volumes:
      - '{{ omada_controller_docker_volumes.data }}:/opt/tplink/EAPController/data'
      - '{{ omada_controller_docker_volumes.logs }}:/opt/tplink/EAPController/logs'
