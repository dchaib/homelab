services:
  {{ monitoring.redis_exporter }}:
    image: oliver006/redis_exporter:v1.91.1
    restart: unless-stopped
    user: "{{ docker_compose_stack_uid }}:{{ docker_compose_stack_gid }}"
    environment:
      - REDIS_ADDR=
      - REDIS_PASSWORD_FILE=/config/redis_passwords.json
    volumes:
      - "{{ redis_exporter_config_folder }}:/config:ro"
    networks:
      - {{ docker_networks.monitoring }}

networks:
  {{ docker_networks.monitoring }}:
    external: true
