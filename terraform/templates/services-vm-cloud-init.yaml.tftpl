#cloud-config
hostname: ${hostname}
fqdn: ${hostname}.home.arpa
manage_etc_hosts: true
disable_root: true
ssh_pwauth: false
users:
  - name: ${admin_username}
    groups:
     - sudo
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
%{ for key in admin_authorized_keys ~}
      - ${key}
%{ endfor ~}
  - name: ${ansible_username}
    groups:
     - sudo
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
%{ for key in ansible_authorized_keys ~}
      - ${key}
%{ endfor ~}

package_update: true
packages:
  - sudo
  - qemu-guest-agent

runcmd:
  - systemctl enable --now qemu-guest-agent
